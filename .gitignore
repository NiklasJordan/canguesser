# Only what's needed to run the app is tracked: server.mjs, events.json, lib/, public/,
# package*.json, Dockerfile, docker-compose.yml, .dockerignore and README.md.

# Event verification output, plus dev tools not used at runtime:
# scripts/ (inspect.mjs, event-sheets.mjs, event-sheet.html) and tools/replica/
verify/
scripts/
tools/

# Dependencies (installed by npm ci in the image)
node_modules/

# Local run data: scores database and events cache when run outside Docker
*.db
*.db-wal
*.db-shm
events-cache.json
*.tmp

# Secrets and local settings
.env
.env.*

# OS and editor clutter
.DS_Store
*.log
.vscode/
.idea/
